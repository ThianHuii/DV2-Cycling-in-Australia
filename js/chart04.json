          {
            "Year": 2021,
            "State": "NT",
            "Bicycle": 2188,
            "Employed": 112217
          },
          {
            "Year": 2021,
            "State": "ACT",
            "Bicycle": 5295,
            "Employed": 274375
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.Bicycle / datum.Employed",
          "as": "Share"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "Rank"
            }
          ],
          "sort": [
            {
              "field": "Share",
              "order": "descending"
            }
          ],
          "groupby": [
            "Year"
          ]
        },
        {
          "calculate": "datum.State + '  ' + format(datum.Share, '.2%')",
          "as": "EndLabel"
        }
      ],
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2010,
              2023
            ],
            "zero": false,
            "nice": false
          },
          "axis": {
            "title": "Census year",
            "values": [
              2011,
              2016,
              2021
            ],
            "format": "d",
            "grid": false,
            "labelAngle": 0,
            "titlePadding": 12
          }
        },
        "y": {
          "field": "Rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              8.5,
              0.5
            ],
            "zero": false,
            "nice": false
          },
          "axis": {
            "title": "Rank by cycling share",
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "format": "d",
            "gridColor": "#E8ECEF",
            "titlePadding": 15
          }
        },
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": [
              "NT",
              "ACT",
              "SA",
              "VIC",
              "QLD",
              "TAS",
              "WA",
              "NSW"
            ],
            "range": [
              "#D55E00",
              "#0072B2",
              "#009E73",
              "#8B5FBF",
              "#B89B00",
              "#CC79A7",
              "#56B4E9",
              "#555555"
            ]
          },
          "legend": null
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "strokeWidth": 3
          },
          "encoding": {
            "detail": {
              "field": "State"
            },
            "order": {
              "field": "Year",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 160,
            "stroke": "#ffffff",
            "strokeWidth": 2
          },
          "encoding": {
            "tooltip": [
              {
                "field": "State",
                "type": "nominal",
                "title": "State / territory"
              },
              {
                "field": "Year",
                "type": "quantitative",
                "title": "Census year",
                "format": "d"
              },
              {
                "field": "Rank",
                "type": "quantitative",
                "title": "Rank",
                "format": "d"
              },
              {
                "field": "Share",
                "type": "quantitative",
                "title": "Bicycle-only commuting share",
                "format": ".2%"
              },
              {
                "field": "Bicycle",
                "type": "quantitative",
                "title": "Bicycle-only commuters",
                "format": ","
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.Year == 2011"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -12,
            "fontSize": 12,
            "fontWeight": "bold"
          },
          "encoding": {
            "text": {
              "field": "State"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.Year == 2021"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 12,
            "fontSize": 12,
            "fontWeight": "bold"
          },
          "encoding": {
            "text": {
              "field": "EndLabel"
            }
          }
        }
      ]
    },
    {
      "width": 620,
      "height": 76,
      "data": {
        "values": [
          {
            "Note": "ACT overtook NT in 2016, but NT regained first place in 2021.\nSouth Australia climbed from sixth to third despite its\ncycling share falling from 1.02% to 0.88%."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "color": "#243746",
        "lineBreak": "\n",
        "lineHeight": 20
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "Note"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#CCCCCC",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
