{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#ffffff",
  "padding": 20,
  "spacing": 22,
  "title": {
    "text": "NT and ACT lead in cycling to work",
    "subtitle": [
      "The territories held the top two positions in 2011, 2016 and 2021.",
      "Bicycle-only commuting share • Place of work • Rank 1 = highest share."
    ],
    "anchor": "start",
    "fontSize": 22,
    "color": "#243746",
    "subtitleFontSize": 12,
    "subtitleColor": "#555555",
    "subtitlePadding": 10,
    "offset": 20
  },
