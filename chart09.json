  "transform": [
    {
      "filter": "datum.Year == SelectedYear"
    },
    {
      "calculate": "split(datum.Counts, ',')",
      "as": "DailyCounts"
    },
    {
      "calculate": "sequence(0, datum.Year == 2020 ? 366 : 365)",
      "as": "Index"
    },
    {
      "flatten": [
        "Index"
      ]
    },
    {
      "calculate": "utc(datum.Year, 0, datum.Index + 1)",
      "as": "Date"
    },
    {
      "calculate": "datum.Index < length(datum.DailyCounts) ? toNumber(datum.DailyCounts[datum.Index]) : null",
      "as": "Count"
    },
    {
      "filter": "utcmonth(datum.Date) + 1 == SelectedMonth"
    },
    {
      "calculate": "(utcday(datum.Date) + 6) % 7",
      "as": "Weekday"
    },
    {
      "calculate": "floor((utcdate(datum.Date) - 1 + (utcday(utc(datum.Year, SelectedMonth - 1, 1)) + 6) % 7) / 7)",
      "as": "Week"
    },
    {
      "calculate": "utcdate(datum.Date)",
      "as": "Day"
    },
    {
      "calculate": "utcFormat(datum.Date, '%A, %d %B %Y')",
      "as": "DateLabel"
    },
    {
      "calculate": "isValid(datum.Count) ? format(datum.Count, ',') : 'No data'",
      "as": "CountLabel"
    }
  ],
